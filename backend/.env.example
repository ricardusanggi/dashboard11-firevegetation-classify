# backend/.env

# Database configuration
# Using SQLite for simplicity; replace with your database URL as needed
#DATABASE_URL=sqlite:///storage/databases/vegetasiclassy.db
ALLOWED_ORIGINS=http://localhost:3011,http://127.0.0.1:3011
DATABASE_URL=sqlite:///storage/databases/vegetasiclassy.db
SECRET_KEY=replace-with-a-secure-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALGORITHM=HS256

TRAIN_DATASET_DIR=./storage/datasets_train
PENDING_DATASET_DIR=./storage/datasets_pending
REJECT_DATASET_DIR=./storage/datasets_reject
TEST_DATASET_DIR=./storage/datasets_test
TEST_TRUE_DIR=./storage/datasets_test_true

TRAIN_MODEL_DIR=./storage/models_train
UPLOAD_MODEL_DIR=./storage/models_upload
PREDICT_MODEL_DIR=./storage/models_predict
REJECT_MODEL_DIR=./storage/models_reject

LOG_DIR=./storage/logs

CASE_DATASET=classification_dataset
ML_TASK=classification


DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_FULLNAME=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_ROLE=admin
DEFAULT_ADMIN_IS_ACTIVE=true
DEFAULT_ADMIN_IS_SUPERUSER=true

# =====================================================
# TRAINING CONFIGURATION (CLASSIFICATION)
# =====================================================

# ---- BASIC TRAINING ----
TRAIN_ARCHITECTURE=resnet18
TRAIN_EPOCHS=3
TRAIN_BATCH_SIZE=8
TRAIN_LEARNING_RATE=0.0001
TRAIN_OPTIMIZER=adam
TRAIN_LOSS_FUNCTION=cross_entropy
TRAIN_AUGMENTATION=true
TRAIN_VAL_SPLIT=0.2
TRAIN_IMG_SIZE=224

# ---- PSO (OPTIONAL) ----
USE_PSO=false
PSO_POPULATION=5
PSO_ITERS=10
PSO_EPOCHS=2

# ---- PSO SEARCH SPACE (BACKEND ONLY) ----
PSO_LR_MIN=0.00001
PSO_LR_MAX=0.001
PSO_DROPOUT_MIN=0.1
PSO_DROPOUT_MAX=0.5
PSO_HIDDEN_SIZES=128,256,512
PSO_BATCH_SIZES=8,16,32
PSO_AUGMENTATION=true

# =====================================================
# PREDICTION CONFIGURATION
# =====================================================
PREDICT_BATCH_SIZE=8
PREDICT_IMG_SIZE=224
PREDICT_THRESHOLD=0.5
PREDICT_AUGMENTATION=false
PREDICT_SLIDE_WINDOW_SIZE=224
PREDICT_SLIDE_WINDOW_STRIDE=112
